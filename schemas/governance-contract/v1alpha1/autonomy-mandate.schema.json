{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FwF reviewed autonomy mandate evidence attachment",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "mandateVersion", "purpose", "defaultDecision", "actions"],
  "properties": {
    "agentId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "mandateVersion": {"const": "1.0.0"},
    "purpose": {"type": "string", "pattern": "\\S"},
    "defaultDecision": {"const": "deny"},
    "actions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["toolName", "disposition", "targets", "reversibility", "impact", "riskReviewRef"],
        "properties": {
          "toolName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "disposition": {"enum": ["allowed", "prohibited", "approval_required"]},
          "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^synthetic-record-[0-9]{3}$"}},
          "reversibility": {"enum": ["reversible", "partially_reversible", "irreversible"]},
          "impact": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["financial", "legal", "privacy", "operational", "customer"]}},
          "riskReviewRef": {"type": "string", "pattern": "\\S"},
          "approval": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["human_approval"]},
              "approverRole": {"const": "OpsManager"},
              "ttlSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
              "evidenceRequired": {"type": "array", "uniqueItems": true, "items": {"enum": ["action_identity", "decision", "executed", "verified"]}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}